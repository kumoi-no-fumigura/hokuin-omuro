  {
   "seq": "1",
   "text": "年なみの立かはりぬるしるしにや氷し水も下むせふなり",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "おく山の谷のふるすのうくひすもたかきにうつる時にあひ鳬",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "梅か香をゝのかはふきににほはせて友さそふなリ鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "春きても雪きえやらぬ吉野山かすみにもまた埋れにけり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "夕かすみそことも見えす立こめて風の音にそきくの濵松",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春かすみしるへかほにて朝たては中〓〓まかふ山路なりけり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "おきかけて遠さかり行聲すなりかすみのうちにうたふ舟人",
   "kana": "",
   "speaker": "おりぬる雲雀",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "八重まては今朝そ霞のこめてけるさゝかき薄きひなのかり庵",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "散かたになるともおらん梅かえの花の盛はやつれもそする",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "梅かえの花にこつたふ鶯のこゑさへにほふ春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "梅のはな咲をくれたる枝みれはわか身のみやは春によそなる",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "をのか色は雪よりそこに埋もれて匂ふに梅はあらはれにけり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "根にかへる花かと見れはまたさかぬ櫻かふたの雪のむら消",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花とみるよそめはかりのふら雲もはらふはつらき春の山風",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "吉野山うき世のほかとのかれきて中!〓花に心とめつる",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "瀧のうへのみふねの山の花さかり峯にもおにもかゝるしら浪",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "かへるさの末ほと遠き山路にもいかゝ見すてむ花の夕はへ",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "かねてより猶あらましにいとふかな花侍峯をすくる春かせ",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いはしろの松の常盤にことよせて野中の櫻ちらすもあらなん",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "ともすれは木の下露に袖ぬらしなつさふ花よ哀とやみる",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "わするなよおなし木陰に尋ねきて馴めるけふの花のまとゐを",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "さくら咲春やなかゐの浦ならむ花にとまらぬ舟人もなし",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "君かへむ干とせの春をかさぬへきためしとみゆる八重櫻かな",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "千世經へきためしときけは八重櫻かされていとゝ仇に思はし",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "花ゆへに世のはかなさをしりぬれは散らすも風のなさけ也鳬",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "みれはおし花ちる峯の夕霞立へたつるもこゝろ有けり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "山さくら雪とふりつゝ跡たえて家路をこまにまかせてそゆく",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "山里の柳さくらも折をえて都のみやは錦なりける",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "數ならて年へぬる身はそれなから猶人なみに衣かへしつ",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "今そみるうの花山のはなさかり明ても月の影殘りけり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "五月雨の日かすつもりの浦なれや下枝もひちぬ住の江の松",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "月も今はかたふくほとに成ぬらむはれすは晴す五月雨の空",
   "kana": "",
   "speaker": "北院御室御集",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "過ぬとも聲のにほひは猶とめよほとゝきすなく宿のたち花",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "軒ちかく一こゑはしてほとゝきすをちの木すゑになこり鳴え",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "ふけてしも山ほとゝきす來鳴乙よひにはまたぬ人も聞とや",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "うれしさは袖にあまりぬほとゝきす鳴かされたる衣手の杜",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "時鳥なのるにしるしこれそこのたれその杜のありす成ける",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "ほとゝきす猶はつこゑをしのふ山夕ゐる雲のそこに鳴なり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "尋ねみてうらみははてむ時鳥いつくもかくや夜かれしつ覽",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "今こそやほたるともしれ散てなをかへりやはをく草の上露",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "伊勢の海の〓きはまへにてる影を玉とひろへはほたる也けり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "葉すゑよりこほるゝ露の心地して蘆分船にほたる飛かふ",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "しはつ山ならの葉かけの夕すゝみおりにもあらぬ秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "涼しさはひとへに秋の心地してゆふ風立ぬ衣手のもり",
   "kana": "",
   "speaker": "",
   "page": 548,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "淺ちふの露けくも有か秋きぬと目にはさやかにみえける物を",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "秋とのみなにかまたまし彥星のあふせをやすのわたり成せは",
   "kana": "",
   "speaker": "おもひたかへし秋はきにけり",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "たなはたの秋さり衣一夜のみかさぬる山となとかなりけん",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "小夜更てしのふけしきのしるしかな霧立かくす星合のそら",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "やつるとも一枝おらん小萩はらはなふみしたく鹿はなしやは",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "分ゆかはたかたもとにかうつるらむ我しめし野の萩か花すり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "野へならはしからむしかにかこたましわれと散ぬる庭の秋萩",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "秋のゝの干くさの色にうつろへは花そかへりて露を染ける",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "をとしるし鹿の通ひちこれなれや霧のあなたにこのはふむ也",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "宮古鳥ありとみえはやことゝはむすみた河原は霧こめてけり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "浦つたふさほのうたのみ聞ゆなりあまの友船霧かくれつゝ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "あけぬとやくらき物から知ぬらむ霧間をわくる鳴の羽かき",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "こからしに虫の音たくふ秋の野は露も泪もとまらさりけり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "おほわたの浦半の風に霧晴て千船の數もみゆる月かけ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "はる〓〓と千里のほかへ行月はをのゝ光やしるへなるらむ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "峯にても雲のちりぬる月影を岩間にあらふ谷のした水",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "風わたるこすゑに雨の音はして月のみそもる松かうら島",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "筑波ねの茂きこまより月もれはこのもかのもの雪のむらきえ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "駒とめてみれは心もうつりけりひのくま河にすめる月かけ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "逢坂のせき路はるかにひく駒の跡なき雪や夜半の月かけ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "世をいとふみ山かくれのすまゐには月さへ雲の塵なかりけり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "舟むやふをしまか磯の梶まくら月さへやとるとまりなりけり",
   "kana": "",
   "speaker": "さまにもおはすうつる月影",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "うきなからやとらむ月を待ほとにいつれはかはく袖の露かな",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "おしみかねひれふるまてそしたはしき松浦の山の有明の月",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "あたにみし露は草葉に農明の月そ中〓〓影はきえゆく",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "明ぬとは宵より見つる月なれと今そ門田に鳴もたつなり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "なにとこのにしへは月のしるへせて事そともなく我誘ふらん",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "これはさはおきゐの里の秋の夜の露まとろまて衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "染殘す木〓の紅葉もあらしとてしくれは山をめくるなり鳬",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "もみち葉のこかれわたるや秋をやくけしきの杜の梢成らむ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "いつしかは色に出しとしのふ山下葉よりこそくみちそめけれ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "白妙の色をうはひて咲にけりいつぬき川の岸のむら菊",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "つねよりも哀はふかし秋くれて人もこすのゝ葛のうら風",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "おしみかねはかなく暮て行秋のなこりにとまる袖の露かな",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "諸共におしむも秋はとまらねとさてはなくさむ方やあらまし",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "行秋もおしむ人ゆへとまるかと君はかりにそけふはまかする",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "冬きぬと水のこゝろやしりぬらん谷風さむみつらゝゐにけり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "さそひ行嵐を道のあるへにて峯うつりする木ミのもみちは",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "龍田川瀨おちの浪も色つきて木のはの下に聲むせふなり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "しくれつゝ過ぬるかたは雲消てひとつけしきにみえぬ空かな",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "はる〓〓といくのゝ道の村しくれ駒とめつへき木の下もかな",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "はらふともそのかひあらし吳竹の夜のまの雪に折ふしにけり",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "めもはるにみるそさひしき菅原やふしみの田井の雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "葉かへせぬ濵松かえも花さきてえもいはしろにふれる雪哉",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "雪のうちにさゝめの衣うちはらひ野はら志のはら分行やたれ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "なに事を月に見わかむかさこしの雲はれわたる峯のふら雪",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "まねかねと猶過まうきけしきかなのへの尾花の雪のしたおれ",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "浪かけはみきはの雪も消なまし心ありても氷る池かな",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "ふみわけむかたこそふらねみ山木の雪の下行まれのかよひ路",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "ゑらゆふを空より誰かたむくらむ今朝はつ雪のふるの神杉",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "はれやらぬ横雲まよひ風さえて山のはふろきゆきの明ほの",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "はしたてやよさの浦松ふく風に聲をたくへて千鳥と渡る",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "むれてゐるをのか羽風に浪たてゝこゝろとさはくうら千鳥哉",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "夜を寒みさほ風をくるたよりには千鳥のこゑも瀨〓わたる也",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "はねかはす友ねのをしは打とけて氷そむすふこやの池水",
   "kana": "",
   "speaker": "",
   "page": 549,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "あき氷とけなむ後と契りをきて空にわかるゝ池の水とり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "行年の別れはかりをなけきにて身にはつもらぬならひ成せは",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "ひと方に思ひそはてぬ春なまつ心におしき年のくれかな",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "雪のうちに暮ぬる年そ惜まるゝ我身もいたくふりぬと思へは",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "年くるゝ雪のうちにはふりぬともあけなは春にあはし物かは",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "思ひてのあらは心もとまりなむ厭ひ易きはうき世成けり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "何事を待ともなしになからへておしからぬ身の年をふるかな",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "我からや神の惠もへたつらむうき身のほとをみつの玉垣",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "何事も夢になり行いにしへのおもかけのこる明くれの空",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "うらさひて葛はひかくる槇の屋に窓うちすさふ村雨のこゑ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "岩そゝく水よりほかに音せねは心ひとつをすましてそきく",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "葎はふふつのふと屋の夕けふりはれぬ思ひによそへてそ見る",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "故〓をいとゝよそにそへたてつるこゑこし山のやへのまら雲",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "いなしきやひなのかりねはめもあはて都を夢の内にたにみぬ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "ふみなれぬ岩根をつたふ通路にふはしたちのけ峯のあら雲",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "よそにては通ひちなしとみし峯を雲ふみわけて山そこえゆく",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "ふみゆけは濵松かえに風こえてなさけありその磯枕かな",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "よしさらは磯の蓬屋に旅寢せむ浪かけすとてぬれぬ袖かは",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "限あれは身こそ數にもいらさらめ心のゆくをいとはさらなむ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "言の葉のたよりのかせにちるときにかよふ心も色にみえける",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "日數へしひなの住ゐをおもひいては戀しかるへき旅の空かな",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "月のみそもり明しつるもしほ草あきつの浦の松のふたふし",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "跡たえて世をのかるへき道なれや岩さへ苔のころもきてけり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "唐船につめるたからやあまるらむ今はの身をも玉そ散ける",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "はかなしやいかなる野邊の蓬生につゐにはたれも枕さためむ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "つねならぬ此世のはてそ哀なるおもへは誰もよもきふのちり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "なきあゝに影をたにや1留むへきかへらぬ水の泡ときえなは",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "明方のねさめのとこはうつゝにてうき世を夢と思ひゑりぬる",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "有し世の松のみとりのげしきにてうき身は賴む陰なかりけり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "はかなくて消にし路を來てみれは露所せき庭のむら草",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "昔みし住家ともなくあれはてゝおもひしよりも淋しかりけり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "一すちに物そかなしきかりにすむあるし絕にし靑柳の糸",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "せきあへぬ泪はたくひ有島とおりしもむせぶ瀧つせのこゑ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "をくれゐて獨なかむる庭の雪に心まてこそうつもれにけり",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "苔の下に笛の音まても埋もれて只名はかりそ世にとまりける",
   "kana": "",
   "speaker": "遍昭集",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "袖の上になにのしつくの殘るらんたえにー物をさゝ浪のこゑ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "わか駒を何かはやめんまつち山まつと逢へき道もかよはし",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "おほとりのはかひの霜はきえはてゝ名殘の露もとまらさり鳬",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "もろ共にとなへ馴にし法の聲そのふし〓〓をいつか忘れむ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "なきをさてかたみにとまる藻汐草浦さひてこそ波はかけゝれ",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "迷ふへき闇をはしらてはかなくも霧のたえまと思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "ふき馴し玉のよこ笛ぬしなくてさもあらぬかねの音そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 550,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
